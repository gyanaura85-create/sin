{
  "expo": {
    "name": "NearKart",
    "slug": "nearkart",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./1795078951005.png",
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": [
            "./nearkart_notification.wav"
          ]
        }
      ]
    ],
    "android": {
      "package": "com.nearkart.app",
      "adaptiveIcon": {
        "foregroundImage": "./1795078951005.png",
        "backgroundColor": "#FFFFFF"
      }
    }
  }
}